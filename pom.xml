<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <!--
    Inheritance: we inherit curated dependency versions AND plugin versions from
    the Spring Boot parent. This is the single biggest decision in this file.
    <relativePath/> (empty) = "do not look for ../pom.xml on disk, resolve from the repo".
  -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.5</version>
    <relativePath/>
  </parent>

  <!-- Coordinates (GAV): the unique address of this project. -->
  <groupId>com.kodegravity.exr</groupId>
  <artifactId>exr-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>

  <!--
    packaging=pom => this module contains no source code and produces no jar.
    It is a PARENT (children inherit from it) and an AGGREGATOR (the reactor
    builds every <module> below it, in dependency order).
  -->
  <packaging>pom</packaging>

  <name>EXR :: Parent</name>
  <description>Event eXploreR - release-date and live-event tracking platform</description>

  <properties>
    <!-- Java 21 (LTS). The Spring Boot parent uses this to set the compiler release. -->
    <java.version>21</java.version>
    <!-- UTF-8 everywhere: source, resources and reports. Never rely on the OS default. -->
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!--
      The Docker Engine API version the docker-java client (under Testcontainers)
      asks for. Docker 29 refuses anything below its minimum with a bare 400, and
      docker-java's own default is 1.32 - hence this pin. Bump only if you have a
      reason; see the surefire comment in <build>.
    -->
    <docker.api.version>1.44</docker.api.version>
  </properties>

  <modules>
    <!--
      Registered here as each module is created. The reactor builds them in
      dependency order, so exr-common is built before the services that use it.
    -->
    <module>libs/exr-common</module>
    <module>services/catalog-service</module>
  </modules>

  <!--
    Versions for OUR OWN modules, so a service can depend on exr-common without
    repeating the version number. External libraries get their versions from the
    Spring Boot parent's dependencyManagement; this block adds to it.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.kodegravity.exr</groupId>
        <artifactId>exr-common</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <!--
      pluginManagement = "configuration only, activate nothing here".
      The Spring Boot parent already declares surefire; this block merges extra
      configuration into it, and every child module inherits the result.
    -->
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <configuration>
            <!--
              WHY THIS EXISTS - a real-world trap, not decoration.

              Docker Engine 29 raised the floor on the API version it accepts and
              answers 400 Bad Request to anything older. The docker-java client
              that Testcontainers bundles asks for /v1.32/, so Testcontainers
              cannot find a Docker environment at all and every integration test
              dies at class initialisation with:

                Could not find a valid Docker environment
                ... BadRequestException (Status 400: {"ID":"","Containers":0, ...})

              docker-java reads this key from env, ~/.docker-java.properties or
              system properties (DefaultDockerClientConfig uses both). Passing it
              to the forked test JVM keeps the fix in the repo instead of in one
              developer's home directory.
            -->
            <systemPropertyVariables>
              <api.version>${docker.api.version}</api.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

</project>
